[Unit]
Description=Envy Personal Assistant
After=network.target sound.target

[Service]
Type=simple
WorkingDirectory=/opt/envy
ExecStart=/opt/envy/start-envy.sh --profile balanced --no-dashboard
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5
User=envy

[Install]
WantedBy=multi-user.target
