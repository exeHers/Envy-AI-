[Unit]
Description=Envy Personal Assistant
After=network.target sound.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/workspace/envy
Environment="PATH=/workspace/envy/.venv/bin:/usr/bin:/bin"
ExecStart=/workspace/envy/start-envy.sh --profile balanced
Restart=on-failure
RestartSec=5
StandardOutput=append:/workspace/envy/logs/systemd-envy.log
StandardError=append:/workspace/envy/logs/systemd-envy.err

[Install]
WantedBy=multi-user.target
