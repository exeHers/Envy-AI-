[Unit]
Description=Envy Personal Assistant
After=network.target sound.target

[Service]
Type=simple
User=%i
WorkingDirectory=/opt/envy
Environment="PATH=/opt/envy/venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/opt/envy/venv/bin/python /opt/envy/main.py --profile balanced
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
